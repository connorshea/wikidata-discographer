{
  "name": "wikidata-discographer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"node --watch server/index.ts\" \"vp dev\"",
    "dev:server": "node --watch server/index.ts",
    "dev:client": "vp dev",
    "build": "vp build",
    "start": "node server/index.ts",
    "lint": "vp lint",
    "preview": "vp preview",
    "prepare": "vp config",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "job:import-dump": "node jobs/import-dump.ts",
    "job:prune-sessions": "node jobs/prune-sessions.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "mysql2": "^3.24.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.27.0"
}
