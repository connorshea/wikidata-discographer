# Copy to .env and fill in. On Toolforge, set these with
# `toolforge envvars create NAME value` instead of a .env file.

# --- Web server -------------------------------------------------------------
# Public origin of the app; the OAuth callback is $BASE_URL/api/auth/callback.
# In dev the Vite server on :5173 proxies /api to the Node server on $PORT.
# On Toolforge: https://wikidata-discographer.toolforge.org
BASE_URL=http://localhost:5173
PORT=8000

# --- MariaDB ----------------------------------------------------------------
# Defaults match a local dev DB. On Toolforge use the ToolsDB credentials
# (DB_HOST=tools.db.svc.wikimedia.cloud, DB_NAME=<credentialuser>__discographer).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=discographer
DB_PASSWORD=discographer
DB_NAME=discographer

# --- Wikimedia OAuth 2.0 ----------------------------------------------------
# Register a confidential OAuth 2.0 consumer at
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2
# with the callback URL above and the grants "Basic rights", "High-volume
# editing" and "Edit existing pages" + "Create, edit, and move pages".
# Without these, login returns 503 and the rest of the app still works.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Signs the short-lived login-state cookie; at least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Encrypts stored OAuth tokens; 32 bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
# When rotating TOKEN_ENC_KEY, keep the old key here until tokens are re-written.
# TOKEN_ENC_KEY_PREVIOUS=

# Where edits go. Point at test.wikidata.org while developing (the consumer
# must then be registered there too).
# WIKIDATA_API_URL=https://test.wikidata.org/w/api.php
# OAUTH_ISSUER=https://test.wikidata.org/w/rest.php/oauth2

# Gaps between a user's Wikidata writes, before a create and before any other
# edit, and between anyone's writes across the server, in milliseconds.
# WIKIDATA_CREATE_GAP_MS=5000
# WIKIDATA_EDIT_GAP_MS=2000
# WIKIDATA_SERVER_GAP_MS=1000

# Sent on every Wikidata request; add a maintainer contact on Toolforge.
# USER_AGENT=wikidata-discographer/0.1.0 (https://wikidata-discographer.toolforge.org; you@example.org)

# MusicBrainz's web service, for loading a release into the form. Requests use
# USER_AGENT too, as MusicBrainz asks.
# MUSICBRAINZ_API_URL=https://musicbrainz.org/ws/2

# --- Weekly dump import (jobs/import-dump.ts) ------------------------------
# WIKIDATA_JSON_DUMP=/public/dumps/public/wikidatawiki/entities/latest-all.json.gz
# Stop after N entities (for a quick local test against a dump sample).
# DUMP_LIMIT=
# DUMP_PRUNE=0 skips deleting items missing from the dump; DUMP_PRUNE_FORCE=1
# lets a prune remove more than 20% of the mirror.
# DUMP_PRUNE=
# DUMP_PRUNE_FORCE=
